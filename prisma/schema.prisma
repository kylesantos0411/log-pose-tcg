datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Pack {
  id          String   @id // e.g. "569001"
  code        String?  // e.g. "ST-01", "OP-01"
  name        String   // e.g. "STARTER DECK -Straw Hat Crew-"
  seriesType  String?  // e.g. "STARTER DECK", "BOOSTER PACK"
  language    String   @default("en")
  cardsCount  Int      @default(0)
  releaseDate String?  // e.g. "2024-11-30"
  releaseOrder Float?  // Numeric sorting order from oldest (1.0) to newest (higher)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cards       Card[]

  @@index([code])
  @@index([releaseDate])
  @@index([releaseOrder])
}

model Card {
  id           String      @id // e.g. "ST01-001" or "OP05-119"
  packId       String
  pack         Pack        @relation(fields: [packId], references: [id], onDelete: Cascade)
  name         String
  category     String      // "Leader", "Character", "Event", "Stage"
  colors       String      // Comma-separated: "Red" or "Red,Green"
  cost         Int?
  power        Int?
  counter      Int?
  attributes   String?     // Comma-separated: "Slash", "Strike", etc.
  types        String?     // Comma-separated traits: "Straw Hat Crew,Supernovas"
  rarity       String      // "Leader", "Common", "Uncommon", "Rare", "SuperRare", "SecretRare", "Special"
  effect       String?
  trigger      String?
  imageUrl     String?
  blockNumber  Int?
  isAltArt     Boolean     @default(false)
  baseCardId   String?     // Base card reference if alternate art
  marketPrice  Float?      // Latest cached market price in USD
  yuyuPrice    Float?      // Authentic Japanese market price in JPY (Yuyu-tei)
  promoSource  String?     // Event or tournament source, e.g. "Flagship Battle Winner", "25th Anniversary"
  hasJpPrint   Boolean     @default(true) // False if English-exclusive with no Japanese print
  releaseDate  String?     // Official Japanese Release Date YYYY-MM-DD
  releaseOrder Float?      // Numeric sorting order from oldest to newest
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userCards    UserCard[]
  priceHistory CardPrice[]

  @@index([name])
  @@index([packId, category])
  @@index([colors])
  @@index([rarity])
  @@index([promoSource])
  @@index([releaseDate])
  @@index([releaseOrder])
}

model UserCard {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quantity      Int      @default(1)
  condition     String   @default("NM") // "NM", "LP", "MP", "HP", "Graded"
  isFoil        Boolean  @default(false)
  language      String   @default("en") // "en", "jp"
  purchasePrice Float?
  purchaseDate  DateTime?
  notes         String?
  isWishlist    Boolean  @default(false)
  forTrade      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cardId])
  @@index([userId])
  @@index([isWishlist])
}

model CardPrice {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source    String   // "TCGPlayer", "Cardmarket", "eBay"
  currency  String   @default("USD")
  price     Float
  lowPrice  Float?
  trend     Float?
  timestamp DateTime @default(now())

  @@index([cardId, timestamp])
}

model Donation {
  id              String   @id @default(uuid())
  donorName       String
  donorEmail      String?
  amount          String?
  referenceNumber String?
  message         String?
  paymentMethod   String   @default("QR Payment")
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  email             String             @unique
  tag               String             @unique // e.g. "PIRATE-LUFFY-1234"
  passwordHash      String
  avatar            String             @default("👒")
  crew              String             @default("Straw Hat Pirates")
  rank              String             @default("Cabin Boy")
  rankBadge         String             @default("⚓")
  isVerified        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userCards         UserCard[]
  verificationCodes VerificationCode[]

  @@index([email])
  @@index([tag])
  @@index([username])
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String   // 6-digit code e.g. "482910"
  type      String   // "register" | "login" | "reset"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, code])
  @@index([expiresAt])
}


